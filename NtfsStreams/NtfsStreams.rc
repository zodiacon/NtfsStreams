/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\NtfsStreams.ico"
IDI_FILE                ICON                    "res\\file.ico"
IDI_FILE_VIEW           ICON                    "res\\file_view.ico"
IDI_FOLDER              ICON                    "res\\folder_document.ico"
IDI_FOLDER_VIEW         ICON                    "res\\folder_view.ico"
IDI_VIEW                ICON                    "res\\view.ico"
IDI_CLOSE               ICON                    "res\\close.ico"
IDI_REFRESH             ICON                    "res\\Refresh.ico"
IDI_STOP                ICON                    "res\\stop.ico"
IDI_SUBFOLDERS          ICON                    "res\\tree.ico"
IDI_COPY                ICON                    "res\\copy.ico"
IDI_DELETE              ICON                    "res\\delete.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open File...\tCtrl+O",       ID_FILE_OPENFILE
        MENUITEM "Open &Folder...\tCtrl+Shift+O", ID_FILE_OPENFOLDER
        MENUITEM SEPARATOR
        POPUP "Recent F&iles"
        BEGIN
            MENUITEM "(None)",                  ID_FILE_RECENTFILES, GRAYED
        END
        POPUP "Recent Fol&ders"
        BEGIN
            MENUITEM "(None)",                  ID_FILE_RECENTFOLDERS, GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&View Selected Files\tEnter", ID_VIEW_VIEWFILES
        MENUITEM "&Refresh\tF5",                ID_VIEW_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "Close &Tab\tCtrl+W",          ID_FILE_CLOSE
        MENUITEM "&Close All",                  ID_VIEW_CLOSEALL
        MENUITEM "Close All &except Current",   ID_VIEW_CLOSEALLBUTTHIS
        MENUITEM SEPARATOR
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Dark Mode",                  ID_OPTIONS_DARKMODE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About NTFS Streams...",      ID_APP_ABOUT
    END
END

IDR_CONTEXT MENU
BEGIN
    POPUP "Folder"
    BEGIN
        MENUITEM "&View Streams\tEnter",        ID_VIEW_VIEWFILES
        MENUITEM SEPARATOR
        MENUITEM "Open in &Explorer",           ID_FOLDER_OPENINEXPLORER
        MENUITEM "&Copy Path\tCtrl+C",          ID_EDIT_COPY
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS
BEGIN
    "O",            ID_FILE_OPENFILE,       VIRTKEY, CONTROL, NOINVERT
    "O",            ID_FILE_OPENFOLDER,     VIRTKEY, SHIFT, CONTROL, NOINVERT
    "W",            ID_FILE_CLOSE,          VIRTKEY, CONTROL, NOINVERT
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_F5,          ID_VIEW_REFRESH,        VIRTKEY, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 213, 84
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About NTFS Streams"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,81,63,50,14
    ICON            IDR_MAINFRAME,IDC_STATIC,7,7,20,20
    LTEXT           "Static",IDC_VERSION,53,10,153,8
    LTEXT           "Static",IDC_COPYRIGHT,53,23,153,8
    CONTROL         "<a>https://github.com/zodiacon/NtfsStreams</a>",IDC_LINK,
                    "SysLink",WS_TABSTOP,49,40,157,14
END


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Scorpio Software"
            VALUE "FileDescription", "NTFS Streams"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "NtfsStreams"
            VALUE "LegalCopyright", "Copyright (C) 2016-2026 Pavel Yosifovich"
            VALUE "OriginalFilename", "NtfsStreams.exe"
            VALUE "ProductName", "NTFS Streams"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE
BEGIN
    IDR_MAINFRAME           "NTFS Streams"
END

STRINGTABLE
BEGIN
    ID_FILE_OPENFILE        "Show the alternate streams of a file\nOpen File"
    ID_FILE_OPENFOLDER      "Show the files with alternate streams in a folder\nOpen Folder"
    ID_VIEW_VIEWFILES       "Show the streams of the selected files\nView Files"
    ID_FILE_CLOSE           "Close the active tab\nClose Tab"
    ID_VIEW_CLOSEALL        "Close all tabs\nClose All"
    ID_VIEW_CLOSEALLBUTTHIS "Close all tabs except the current one\nClose All except Current"
    ID_OPTIONS_DARKMODE     "Switch between dark and light mode\nDark Mode"
    ID_VIEW_REFRESH         "Read the streams again\nRefresh"
    ID_FOLDER_SUBFOLDERS    "Look for streams in the folder's subfolders too\nInclude Subfolders"
    ID_FOLDER_STOP          "Stop the scan\nStop"
    ID_FOLDER_OPENINEXPLORER "Show the file in Explorer\nOpen in Explorer"
    ID_EDIT_COPY            "Copy the selection\nCopy"
END

STRINGTABLE
BEGIN
    ID_APP_ABOUT            "Display program information, version number and copyright\nAbout"
    ID_APP_EXIT             "Quit the application\nExit"
END

STRINGTABLE
BEGIN
    ATL_IDS_IDLEMESSAGE     "Ready"
END

STRINGTABLE
BEGIN
    ID_VIEW_TOOLBAR         "Show or hide the toolbar\nToggle ToolBar"
    ID_VIEW_STATUS_BAR      "Show or hide the status bar\nToggle StatusBar"
END

