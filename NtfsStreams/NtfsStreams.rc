/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE
BEGIN
    IDR_MAINFRAME           "NTFS Streams"
END

STRINGTABLE
BEGIN
    ID_FILE_OPENFILE        "Show the alternate streams of a file\nOpen File"
    ID_FILE_OPENFOLDER      "Show the files with alternate streams in a folder\nOpen Folder"
    ID_VIEW_VIEWFILES       "Show the streams of the selected files\nView Files"
    ID_FILE_CLOSE           "Close the active tab\nClose Tab"
    ID_VIEW_CLOSEALL        "Close all tabs\nClose All"
    ID_VIEW_CLOSEALLBUTTHIS "Close all tabs except the current one\nClose All except Current"
    ID_OPTIONS_DARKMODE     "Switch between dark and light mode\nDark Mode"
    ID_VIEW_REFRESH         "Read the streams again\nRefresh"
    ID_FOLDER_SUBFOLDERS    "Look for streams in the folder's subfolders too\nInclude Subfolders"
    ID_FOLDER_STOP          "Stop the scan\nStop"
    ID_FOLDER_OPENINEXPLORER "Show the file in Explorer\nOpen in Explorer"
    ID_EDIT_COPY            "Copy the selection\nCopy"
    ID_STREAM_EXPORT        "Save the selected stream's contents to a file\nExport Stream"
    ID_HEX_BYTESPERLINE     "How many bytes each line of the hex view shows\nBytes per Line"
    ID_HEX_DATASIZE         "The size of the hex view's items\nItem Size"
    ID_TEXT_ENCODING        "How the text pane decodes the stream\nText Encoding"
    ID_STREAM_NEW           "Add a stream with text to the file\nNew Stream"
    ID_STREAM_IMPORT        "Add a stream with a file's contents\nImport File as Stream"
    ID_STREAM_EDITTEXT      "Edit the selected stream as text\nEdit Text"
    ID_STREAM_EDITBYTES     "Edit the selected stream's bytes in the hex view\nEdit Bytes"
    ID_STREAM_SAVE          "Write the edited bytes to the stream\nSave Changes"
    ID_STREAM_DISCARD       "Forget the edits and show the stream as it is\nDiscard Changes"
    ID_STREAM_RENAME        "Rename the selected stream\nRename"
    ID_STREAM_DELETE        "Delete the selected stream\nDelete"
    ID_FOLDER_UNBLOCK       "Remove the Zone.Identifier stream (the mark of the web) from the selected files\nUnblock"
    ID_FOLDER_DELETESTREAMS "Delete all the alternate streams of the selected files\nDelete All Streams"
    ID_OPTIONS_KEEPFILETIMES "Put the files' times back after their streams change\nKeep File Times"
    ID_OPTIONS_EXPLORERMENU "Add View NTFS Streams to Explorer's menu for files and folders (on Windows 11: Show more options)\nExplorer Menu"
END

STRINGTABLE
BEGIN
    ID_APP_ABOUT            "Display program information, version number and copyright\nAbout"
    ID_APP_EXIT             "Quit the application\nExit"
END

