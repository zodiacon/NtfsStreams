/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\NtfsStreams.ico"
IDI_FILE                ICON                    "res\\file.ico"
IDI_FILE_VIEW           ICON                    "res\\file_view.ico"
IDI_FOLDER              ICON                    "res\\folder_document.ico"
IDI_FOLDER_VIEW         ICON                    "res\\folder_view.ico"
IDI_VIEW                ICON                    "res\\view.ico"
IDI_CLOSE               ICON                    "res\\close.ico"
IDI_REFRESH             ICON                    "res\\Refresh.ico"
IDI_STOP                ICON                    "res\\stop.ico"
IDI_SUBFOLDERS          ICON                    "res\\tree.ico"
IDI_COPY                ICON                    "res\\copy.ico"
IDI_DELETE              ICON                    "res\\delete.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open File...\tCtrl+O",       ID_FILE_OPENFILE
        MENUITEM "Open &Folder...\tCtrl+Shift+O", ID_FILE_OPENFOLDER
        MENUITEM SEPARATOR
        POPUP "Recent F&iles"
        BEGIN
            MENUITEM "(None)",                  ID_FILE_RECENTFILES, GRAYED
        END
        POPUP "Recent Fol&ders"
        BEGIN
            MENUITEM "(None)",                  ID_FILE_RECENTFOLDERS, GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&View Selected Files\tEnter", ID_VIEW_VIEWFILES
        MENUITEM "&Refresh\tF5",                ID_VIEW_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "Close &Tab\tCtrl+W",          ID_FILE_CLOSE
        MENUITEM "&Close All",                  ID_VIEW_CLOSEALL
        MENUITEM "Close All &except Current",   ID_VIEW_CLOSEALLBUTTHIS
        MENUITEM SEPARATOR
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Stream"
    BEGIN
        MENUITEM "&New Stream...\tCtrl+N",      ID_STREAM_NEW
        MENUITEM "&Import File as Stream...",   ID_STREAM_IMPORT
        MENUITEM SEPARATOR
        MENUITEM "Edit &Text...",               ID_STREAM_EDITTEXT
        MENUITEM "Edit &Bytes",                 ID_STREAM_EDITBYTES
        MENUITEM "&Save Changes\tCtrl+S",       ID_STREAM_SAVE
        MENUITEM "&Discard Changes",            ID_STREAM_DISCARD
        MENUITEM SEPARATOR
        MENUITEM "&Rename...\tF2",              ID_STREAM_RENAME
        MENUITEM "De&lete\tDel",                ID_STREAM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Export...\tCtrl+E",          ID_STREAM_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "&Unblock Selected Files",     ID_FOLDER_UNBLOCK
        MENUITEM "Delete &All Streams of Selected Files", ID_FOLDER_DELETESTREAMS
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Dark Mode",                  ID_OPTIONS_DARKMODE
        MENUITEM "&Keep File Times When Changing Streams", ID_OPTIONS_KEEPFILETIMES
        MENUITEM SEPARATOR
        MENUITEM "Add to &Explorer's Context Menu", ID_OPTIONS_EXPLORERMENU
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About NTFS Streams...",      ID_APP_ABOUT
    END
END

IDR_CONTEXT MENU
BEGIN
    POPUP "Folder"
    BEGIN
        MENUITEM "&View Streams\tEnter",        ID_VIEW_VIEWFILES
        MENUITEM SEPARATOR
        MENUITEM "Open in &Explorer",           ID_FOLDER_OPENINEXPLORER
        MENUITEM "&Copy Path\tCtrl+C",          ID_EDIT_COPY
        MENUITEM SEPARATOR
        MENUITEM "&Unblock",                    ID_FOLDER_UNBLOCK
        MENUITEM "&Delete All Streams",         ID_FOLDER_DELETESTREAMS
    END
    POPUP "Stream"
    BEGIN
        MENUITEM "&Export...\tCtrl+E",          ID_STREAM_EXPORT
        MENUITEM "&Copy Name\tCtrl+C",          ID_EDIT_COPY
        MENUITEM SEPARATOR
        MENUITEM "Edit &Text...",               ID_STREAM_EDITTEXT
        MENUITEM "Edit &Bytes",                 ID_STREAM_EDITBYTES
        MENUITEM SEPARATOR
        MENUITEM "&Rename...\tF2",              ID_STREAM_RENAME
        MENUITEM "De&lete\tDel",                ID_STREAM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&New Stream...\tCtrl+N",      ID_STREAM_NEW
        MENUITEM "&Import File as Stream...",   ID_STREAM_IMPORT
    END
    POPUP "Bytes per Line"
    BEGIN
        MENUITEM "&8 Bytes per Line",           ID_HEX_LINE8
        MENUITEM "&16 Bytes per Line",          ID_HEX_LINE16
        MENUITEM "&32 Bytes per Line",          ID_HEX_LINE32
    END
    POPUP "Item Size"
    BEGIN
        MENUITEM "&Byte",                       ID_HEX_SIZE1
        MENUITEM "&Word (2 Bytes)",             ID_HEX_SIZE2
        MENUITEM "&DWord (4 Bytes)",            ID_HEX_SIZE4
        MENUITEM "&QWord (8 Bytes)",            ID_HEX_SIZE8
    END
    POPUP "Encoding"
    BEGIN
        MENUITEM "&Auto",                       ID_TEXT_AUTO
        MENUITEM "A&SCII",                      ID_TEXT_ASCII
        MENUITEM "UTF-&8",                      ID_TEXT_UTF8
        MENUITEM "UTF-1&6",                     ID_TEXT_UTF16
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS
BEGIN
    "O",            ID_FILE_OPENFILE,       VIRTKEY, CONTROL, NOINVERT
    "O",            ID_FILE_OPENFOLDER,     VIRTKEY, SHIFT, CONTROL, NOINVERT
    "W",            ID_FILE_CLOSE,          VIRTKEY, CONTROL, NOINVERT
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    "E",            ID_STREAM_EXPORT,       VIRTKEY, CONTROL, NOINVERT
    "N",            ID_STREAM_NEW,          VIRTKEY, CONTROL, NOINVERT
    "S",            ID_STREAM_SAVE,         VIRTKEY, CONTROL, NOINVERT
    VK_F5,          ID_VIEW_REFRESH,        VIRTKEY, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_NAME DIALOGEX 0, 0, 260, 78
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Name"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    LTEXT           "Name:",IDC_PROMPT,7,7,246,10
    EDITTEXT        IDC_NAME,7,19,246,14,ES_AUTOHSCROLL
    LTEXT           "",IDC_NAME_ERROR,7,37,246,10
    DEFPUSHBUTTON   "OK",IDOK,149,57,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,203,57,50,14
END

IDD_TEXTSTREAM DIALOGEX 0, 0, 360, 240
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Text Stream"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    LTEXT           "&Name:",IDC_STATIC,7,9,40,10
    EDITTEXT        IDC_NAME,50,7,303,14,ES_AUTOHSCROLL
    LTEXT           "&Encoding:",IDC_STATIC,7,28,40,10
    COMBOBOX        IDC_ENCODING,50,26,80,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "&Byte order mark",IDC_BOM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,140,28,90,10
    EDITTEXT        IDC_TEXT,7,45,346,168,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL
    LTEXT           "",IDC_NAME_ERROR,7,222,230,10
    DEFPUSHBUTTON   "OK",IDOK,249,219,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,303,219,50,14
END

IDD_ABOUTBOX DIALOGEX 0, 0, 213, 84
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About NTFS Streams"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,81,63,50,14
    ICON            IDR_MAINFRAME,IDC_STATIC,7,7,20,20
    LTEXT           "Static",IDC_VERSION,53,10,153,8
    LTEXT           "Static",IDC_COPYRIGHT,53,23,153,8
    CONTROL         "<a>https://github.com/zodiacon/NtfsStreams</a>",IDC_LINK,
                    "SysLink",WS_TABSTOP,49,40,157,14
END


